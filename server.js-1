      transition: all 0.3s ease;
      text-align: center;
    }

    .acta-link:hover {
      background: #27ae60;
      transform: translateY(-1px);
    }

    .acta-link.disabled {
      background: #ccc;
      cursor: not-allowed;
      pointer-events: none;
    }

    /* Footer */
    .footer {
      background: #1a1a2e;
      color: white;
      text-align: center;
      padding: 32px 0;
      margin-top: 48px;
      font-size: 0.9rem;
      opacity: 0.9;
    }

    /* Leaflet Popup Override */
    .leaflet-popup-content-wrapper {
      border-radius: 12px;
      box-shadow: 0 4px 16px rgba(0, 0, 0, 0.15);
    }

    .leaflet-popup-content {
      font-family: 'Inter', sans-serif;
      font-size: 0.95rem;
    }

    .popup-title {
      font-weight: 600;
